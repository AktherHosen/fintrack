{
  "name": "fintrack",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:clean": "node scripts/dev-clean.mjs && pnpm dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @fintrack/api db:generate",
    "db:migrate": "pnpm --filter @fintrack/api db:migrate",
    "db:deploy": "pnpm --filter @fintrack/api db:deploy",
    "db:seed": "pnpm --filter @fintrack/api db:seed"
  },
  "engines": {
    "node": ">=20"
  }
}
