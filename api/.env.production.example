# Production environment template for the API service.
# Copy to .env on your server and fill in real values.

NODE_ENV=production
PORT=4000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fintrack?schema=public"

# Public URLs (must match your deployed domains)
APP_URL="https://app.example.com"
API_URL="https://api.example.com"
WEB_ORIGIN="https://app.example.com"

# Required — use a long random string (32+ chars)
SESSION_SECRET="replace-with-long-random-secret"

# Optional
BKASH_PAYMENT_NUMBER="01XXXXXXXXX"
ADMIN_EMAIL="admin@fintrack.local"
ADMIN_PASSWORD="change-after-first-login"

# Email (optional — password reset)
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASSWORD=""
